  "components": {
    "schemas": {
      "CapabilityProfile": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": "primary"
          },
          "displayName": {
            "type": "string",
            "title": "Displayname",
            "default": "Norn Builder"
          },
          "biography": {
            "type": "string",
            "title": "Biography",
            "default": ""
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillClaim"
            },
            "type": "array",
            "title": "Skills"
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/ProjectClaim"
            },
            "type": "array",
            "title": "Projects"
          },
          "preferredOpportunities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferredopportunities"
          },
          "supportedEcosystems": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supportedecosystems"
          },
          "constraints": {
            "$ref": "#/components/schemas/ProfileConstraints"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "title": "CapabilityProfile"
      },
      "ClaimStatus": {
        "type": "string",
        "enum": [
          "verified",
          "claimed",
          "aspirational"
        ],
        "title": "ClaimStatus"
      },
      "CriterionScore": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "maximum": {
            "type": "number",
            "title": "Maximum"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "score",
          "maximum",
          "reason"
        ],
        "title": "CriterionScore"
      },
      "DiscoverRequest": {
        "properties": {
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CapabilityProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "query": {
            "type": "string",
            "title": "Query",
            "default": ""
          },
          "types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Types"
          },
          "maximumResults": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Maximumresults",
            "default": 25
          }
        },
        "type": "object",
        "title": "DiscoverRequest"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "repository",
              "deployment",
              "test",
              "transaction",
              "demo",
              "documentation",
              "profile",
              "other"
            ],
            "title": "Kind"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Digest"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus",
            "default": "claimed"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "kind"
        ],
        "title": "Evidence"
      },
      "FitAssessment": {
        "properties": {
          "opportunityId": {
            "type": "string",
            "title": "Opportunityid"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "expectedValueIndex": {
            "type": "number",
            "minimum": 0.0,
            "title": "Expectedvalueindex"
          },
          "eligibility": {
            "type": "string",
            "enum": [
              "eligible",
              "likely",
              "uncertain",
              "ineligible"
            ],
            "title": "Eligibility"
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "pursue_now",
              "close_gaps_first",
              "watch",
              "skip"
            ],
            "title": "Recommendation"
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionScore"
            },
            "type": "array",
            "title": "Criteria"
          },
          "strongEvidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strongevidence"
          },
          "missingEvidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missingevidence"
          },
          "rationale": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rationale"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/GapItem"
            },
            "type": "array",
            "title": "Gaps"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Generatedat"
          }
        },
        "type": "object",
        "required": [
          "opportunityId",
          "score",
          "expectedValueIndex",
          "eligibility",
          "recommendation",
          "criteria",
          "strongEvidence",
          "missingEvidence",
          "rationale",
          "gaps"
        ],
        "title": "FitAssessment"
      },
      "GapItem": {
        "properties": {
          "requirement": {
            "type": "string",
            "title": "Requirement"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "partial",
              "missing",
              "not_applicable"
            ],
            "title": "Status"
          },
          "matchedEvidenceIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matchedevidenceids"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "recommendedAction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendedaction"
          }
        },
        "type": "object",
        "required": [
          "requirement",
          "status",
          "reason"
        ],
        "title": "GapItem"
      },
      "GapRequest": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/CapabilityProfile"
          },
          "opportunity": {
            "$ref": "#/components/schemas/Opportunity"
          }
        },
        "type": "object",
        "required": [
          "profile",
          "opportunity"
        ],
        "title": "GapRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "paymentMode": {
            "type": "string",
            "title": "Paymentmode"
          },
          "blockers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Blockers"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "paymentMode"
        ],
        "title": "HealthResponse"
      },
      "ImportOpportunityRequest": {
        "properties": {
          "opportunities": {
            "items": {
              "$ref": "#/components/schemas/Opportunity"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Opportunities"
          }
        },
        "type": "object",
        "required": [
          "opportunities"
        ],
        "title": "ImportOpportunityRequest"
      },
      "Opportunity": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "type": {
            "type": "string",
            "enum": [
              "job",
              "contract",
              "grant",
              "hackathon",
              "bounty",
              "accelerator",
              "investment",
              "research",
              "partnership",
              "rfp",
              "speaking",
              "publishing",
              "competition",
              "incentive",
              "other"
            ],
            "title": "Type"
          },
          "issuer": {
            "type": "string",
            "title": "Issuer"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          },
          "value": {
            "$ref": "#/components/schemas/OpportunityValue"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "requirements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Requirements"
          },
          "preferredCapabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferredcapabilities"
          },
          "ecosystems": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ecosystems"
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Sourceurl"
          },
          "sourceTimestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Sourcetimestamp"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "official",
              "aggregator",
              "manual",
              "fixture"
            ],
            "title": "Sourcetype",
            "default": "manual"
          },
          "applicationEffort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Applicationeffort",
            "default": "medium"
          },
          "competitiveIntensity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ],
            "title": "Competitiveintensity",
            "default": "unknown"
          },
          "longTermValue": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Longtermvalue",
            "default": 50
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closing",
              "closed",
              "unknown"
            ],
            "title": "Status",
            "default": "unknown"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "issuer",
          "sourceUrl"
        ],
        "title": "Opportunity"
      },
      "OpportunityBriefResponse": {
        "properties": {
