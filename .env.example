APP_NAME=Norn
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
NORN_DATA_DIR=./runtime-data

# free: no payment; demo: local 402 harness; okx: official SDK + facilitator
PAYMENT_MODE=free
PAYMENT_NETWORK=eip155:196
PAYMENT_PRICE=$0.01
# Official X Layer USDT0 contract; 6 decimals, so 10000 atomic units = 0.01 USDT0.
PAYMENT_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
PAYMENT_ATOMIC_AMOUNT=10000
PAY_TO_ADDRESS=
PAYMENT_MAX_TIMEOUT_SECONDS=300

# Required only for PAYMENT_MODE=okx. Keep these in the hosting secret manager.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com

# Local test harness only. Never use demo mode in production.
DEMO_PAYMENT_SECRET=local-test-only

# Opportunity Compiler v2. Supply the complete official source bundle: announcement,
# rules, FAQ, prizes, application page, technical docs and update pages.
ENABLE_LIVE_DISCOVERY=false
NORN_SOURCE_BUNDLE_URLS=
# Deprecated alias retained for compatibility.
NORN_SOURCE_FEED_URLS=
GITHUB_TOKEN=
# Separate GitHub search queries with double semicolons.
# Example: is:issue is:open label:bounty language:Solidity;;is:issue is:open "reward"
NORN_GITHUB_QUERIES=
